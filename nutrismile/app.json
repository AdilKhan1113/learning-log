{
  "expo": {
    "name": "NutriSmile",
    "slug": "nutrismile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nutrismile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12131A",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutrismile.app",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriSmile uses the camera to scan barcodes and photograph meals."
      }
    },
    "android": {
      "package": "com.nutrismile.app",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12131A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "NutriSmile uses the camera to scan barcodes and photograph meals."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#12131A"
        }
      ]
    ],
    "extra": {
      "comment": "Public config only. API keys live in Supabase Edge Function secrets, never here. `eas init` adds extra.eas.projectId here on first build."
    }
  }
}
