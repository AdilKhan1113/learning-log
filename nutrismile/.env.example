# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# These two are PUBLIC by design — the anon key is meant to be in the app
# bundle, and Supabase's row-level security is what protects the data. Every
# secret key (Gemini, Anthropic, USDA) lives in Supabase Edge Function secrets
# instead, and never appears here.
#
# Find both under: Supabase dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Expo inlines EXPO_PUBLIC_* at bundle time, so restart the dev server after
# changing this file: npm start -- --clear
