{
  "name": "nutrismile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run check:schema && node --test tests/domain/*.test.ts tests/services/*.test.ts tests/db/*.test.mjs && node tests/db/schema.smoke.mjs",
    "test:schema": "node tests/db/schema.smoke.mjs",
    "test:domain": "node --test tests/domain/*.test.ts tests/services/*.test.ts",
    "build:schema": "node scripts/build-schema.mjs",
    "check:schema": "node scripts/build-schema.mjs --check",
    "test:sql": "node --test tests/db/*.test.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-router": "~57.0.20",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.0"
  }
}
